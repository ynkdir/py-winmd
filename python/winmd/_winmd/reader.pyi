class database:
    """
    One .winmd file: the 38 metadata tables, plus the string and blob heaps.

        db = database("Windows.Win32.winmd")
        print(db.TypeDef.size(), "types")
        for row in db.ImplMap:                         # a table nothing else reaches
            ...

    Every table is an attribute named after it (TypeDef, MethodDef, ImplMap, ...),
    and each is a sequence of rows. Use a cache instead when a type may refer to
    another file, which is nearly always; a database on its own resolves nothing.
    """

    @overload
    def __init__(self, buffer: bytes, cache: cache | None = None) -> None: ...

    @overload
    def __init__(self, path: str, cache: cache | None = None) -> None: ...

    @staticmethod
    def is_database(path: str) -> bool:
        """Whether the file is metadata at all - cheap, and does not throw."""

    def path(self) -> str: ...

    def get_cache(self) -> cache: ...

    def get_string(self, index: int) -> str: ...

    def get_blob(self, index: int) -> byte_view: ...

    @property
    def Module(self) -> Module_table: ...

    @property
    def TypeRef(self) -> TypeRef_table: ...

    @property
    def TypeDef(self) -> TypeDef_table: ...

    @property
    def Field(self) -> Field_table: ...

    @property
    def MethodDef(self) -> MethodDef_table: ...

    @property
    def Param(self) -> Param_table: ...

    @property
    def InterfaceImpl(self) -> InterfaceImpl_table: ...

    @property
    def MemberRef(self) -> MemberRef_table: ...

    @property
    def Constant(self) -> Constant_table: ...

    @property
    def CustomAttribute(self) -> CustomAttribute_table: ...

    @property
    def FieldMarshal(self) -> FieldMarshal_table: ...

    @property
    def DeclSecurity(self) -> DeclSecurity_table: ...

    @property
    def ClassLayout(self) -> ClassLayout_table: ...

    @property
    def FieldLayout(self) -> FieldLayout_table: ...

    @property
    def StandAloneSig(self) -> StandAloneSig_table: ...

    @property
    def EventMap(self) -> EventMap_table: ...

    @property
    def Event(self) -> Event_table: ...

    @property
    def PropertyMap(self) -> PropertyMap_table: ...

    @property
    def Property(self) -> Property_table: ...

    @property
    def MethodSemantics(self) -> MethodSemantics_table: ...

    @property
    def MethodImpl(self) -> MethodImpl_table: ...

    @property
    def ModuleRef(self) -> ModuleRef_table: ...

    @property
    def TypeSpec(self) -> TypeSpec_table: ...

    @property
    def ImplMap(self) -> ImplMap_table: ...

    @property
    def FieldRVA(self) -> FieldRVA_table: ...

    @property
    def Assembly(self) -> Assembly_table: ...

    @property
    def AssemblyProcessor(self) -> AssemblyProcessor_table: ...

    @property
    def AssemblyOS(self) -> AssemblyOS_table: ...

    @property
    def AssemblyRef(self) -> AssemblyRef_table: ...

    @property
    def AssemblyRefProcessor(self) -> AssemblyRefProcessor_table: ...

    @property
    def AssemblyRefOS(self) -> AssemblyRefOS_table: ...

    @property
    def File(self) -> File_table: ...

    @property
    def ExportedType(self) -> ExportedType_table: ...

    @property
    def ManifestResource(self) -> ManifestResource_table: ...

    @property
    def NestedClass(self) -> NestedClass_table: ...

    @property
