# Local tool settings
.claude/settings.local.json

# NuGet content: downloaded with fetch-packages.ps1
winmd/
metadata/
.packages/
.tools/

# Python environment and build output
.venv/
build/
dist/
__pycache__/
*.pyc
*.egg-info/

# Meson subprojects: only the .wrap files are checked in, the sources are
# downloaded by `meson wrap install` / bootstrap.ps1
subprojects/*
!subprojects/*.wrap
!subprojects/packagefiles/
