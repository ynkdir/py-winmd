# Local tool settings
.claude/settings.local.json

# NuGet content: the .winmd files downloaded with fetch-metadata.py, and the
# C++ headers older checkouts kept in winmd/ (a Meson subproject nowadays).
# Anchored, or it would swallow python/winmd/ and the stubs generated into it.
/winmd/
/metadata/
*.winmd
*.WinMD

# Python environment and build output
.venv/
build/
dist/
__pycache__/
*.pyc
*.egg-info/

# Meson subprojects: only the .wrap files and the package files we add to them
# are checked in, the sources are downloaded by the build
subprojects/*
!subprojects/*.wrap
!subprojects/packagefiles/
